{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.crt)",
      "Read(./**/*.cer)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_dsa*)",
      "Read(./**/id_ecdsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/.npmrc)",
      "Read(./**/.netrc)",
      "Read(./**/.pgpass)",
      "Read(./**/.git-credentials)",
      "Read(./secrets/**)",
      "Read(./docs/analytics.credentials.md)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./secrets/**)",
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(sshpass:*)"
    ],
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm view:*)",
      "Bash(npm audit:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npx prisma format:*)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma migrate status:*)",
      "Bash(npx prisma migrate diff:*)",
      "Bash(npx prisma studio:*)",
      "Bash(npx shadcn:*)",
      "Bash(npx tsx:*)",
      "Bash(PORT=3001 npx playwright test:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker exec:*)",
      "Bash(docker build:*)",
      "Bash(docker image:*)",
      "Bash(docker info:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(gh repo view:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)",
      "Bash(ssh smartplanning:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_isready:*)",
      "Bash(openssl rand:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(xargs:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(node:*)",
      "Bash(bash -n:*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "WebSearch",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:smartplanning.fr)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:legifrance.gouv.fr)",
      "WebFetch(domain:code.travail.gouv.fr)",
      "mcp__plugin_atlassian_atlassian__*",
      "mcp__plugin_context7_context7__*",
      "mcp__context7__*",
      "mcp__chrome-devtools__*",
      "mcp__filesystem__*",
      "mcp__git__*",
      "mcp__ide__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/hook-block-secret-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/hook-rappel-regles.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/hook-warn-unpushed.sh"
          }
        ]
      }
    ]
  }
}
