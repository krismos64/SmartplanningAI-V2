# ==============================================
# SMARTPLANNING V2 - VARIABLES D'ENVIRONNEMENT
# ==============================================

# ----------------------------------------------
# 🗄️ BASE DE DONNÉES (PostgreSQL)
# ----------------------------------------------
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Exemple local Docker : postgresql://smartplanning:smartplanning@localhost:5432/smartplanning?schema=public
DATABASE_URL="postgresql://smartplanning:smartplanning@localhost:5432/smartplanning?schema=public"

# Prisma Direct URL (pour migrations)
# Utilisé pour les migrations Prisma (peut être identique à DATABASE_URL)
DIRECT_URL="postgresql://smartplanning:smartplanning@localhost:5432/smartplanning?schema=public"

# ----------------------------------------------
# 🔐 AUTHENTIFICATION (NextAuth.js v5)
# ----------------------------------------------
# Clé secrète pour signer les JWT (générer avec : openssl rand -base64 32)
AUTH_SECRET="CHANGE_ME_WITH_RANDOM_SECRET_KEY_USE_OPENSSL_RAND_BASE64_32"

# URL de l'application (pour les callbacks NextAuth)
# Development : http://localhost:3000
# Production : https://smartplanning.votredomaine.fr
AUTH_URL="http://localhost:3000"

# Trust host (requis pour VPS/reverse proxy)
# Met à true en production derrière nginx/Apache
AUTH_TRUST_HOST=true

# Algorithme JWT (recommandé : HS256)
AUTH_JWT_ALGORITHM="HS256"

# Durée de vie du token JWT (en secondes, ex: 30 jours = 2592000)
AUTH_JWT_MAX_AGE=2592000

# ----------------------------------------------
# 🚀 APPLICATION
# ----------------------------------------------
# Environnement (development, production, test)
NODE_ENV="development"

# Nom de l'application
NEXT_PUBLIC_APP_NAME="SmartPlanning"

# URL publique de l'application (côté client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Version de l'application
NEXT_PUBLIC_APP_VERSION="2.0.0"

# ----------------------------------------------
# 📧 EMAIL - SMTP Hostinger (SP-295)
# ----------------------------------------------
# Configuration SMTP pour l'envoi d'emails transactionnels
# Utilise le SMTP Hostinger existant (contact@smartplanning.fr)

# Serveur SMTP Hostinger
SMTP_HOST="smtp.hostinger.com"

# Port SMTP : 587 (STARTTLS) ou 465 (SSL)
SMTP_PORT=587

# Email d'authentification SMTP
SMTP_USER="contact@smartplanning.fr"

# Mot de passe SMTP (à récupérer dans le panel Hostinger)
SMTP_PASSWORD="CHANGE_ME_WITH_SMTP_PASSWORD"

# Adresse d'expédition formatée (From header)
SMTP_FROM="SmartPlanning <contact@smartplanning.fr>"

# Email destinataire pour le formulaire de contact (optionnel, défaut: SMTP_USER)
CONTACT_EMAIL="contact@smartplanning.fr"

# Limites Hostinger : 100 emails/jour, 500/heure, 3000/mois

# ----------------------------------------------
# ☁️ CLOUDINARY (Upload d'images - SP-272)
# ----------------------------------------------
# Configuration Cloudinary pour l'upload d'avatars
# Créer un compte gratuit sur https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ----------------------------------------------
# ☁️ STOCKAGE (optionnel pour uploads)
# ----------------------------------------------
# AWS S3 ou compatible (Scaleway, DigitalOcean Spaces, etc.)
# S3_REGION="eu-west-3"
# S3_BUCKET="smartplanning-uploads"
# S3_ACCESS_KEY_ID="xxxxxxxxxxxx"
# S3_SECRET_ACCESS_KEY="xxxxxxxxxxxx"
# S3_ENDPOINT="https://s3.eu-west-3.amazonaws.com" # Optionnel

# ----------------------------------------------
# 🧪 TESTS & DÉVELOPPEMENT
# ----------------------------------------------
# Activer les logs détaillés Prisma (en dev uniquement)
# DEBUG="prisma:*"

# Port de développement Next.js
# PORT=3000

# ----------------------------------------------
# 🤖 IA / API EXTERNES (optionnel pour génération de plannings)
# ----------------------------------------------
# OpenAI API (pour suggestions IA de plannings)
# OPENAI_API_KEY="sk-xxxxxxxxxxxx"
# OPENAI_MODEL="gpt-4"

# ----------------------------------------------
# 📊 MONITORING & ANALYTICS (optionnel)
# ----------------------------------------------
# Sentry (error tracking)
# NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxxxxxx@sentry.io/xxxxxxxxxxxx"

# Google Analytics (legacy)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Umami Analytics (SP-345) - Solution privacy-friendly RGPD
# Website ID récupéré dans le dashboard Umami après création du site
# NEXT_PUBLIC_UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# URL du script Umami (sous-domaine dédié pour éviter les conflits de routing)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://analytics.smartplanning.fr/script.js"

# Domaines autorisés pour le tracking (évite tracking en dev/staging)
# NEXT_PUBLIC_UMAMI_DOMAINS="smartplanning.fr"

# Secret pour l'app Umami (VPS uniquement - générer avec: openssl rand -base64 32)
# UMAMI_APP_SECRET="CHANGE_ME_WITH_RANDOM_SECRET"

# ----------------------------------------------
# 💳 STRIPE - Paiement SaaS (SP-349)
# ----------------------------------------------
# Clés API Stripe (mode test pour développement, mode live pour production)
# Récupérer dans : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook secret (généré lors de la création de l'endpoint webhook dans Stripe Dashboard)
# En dev local : utiliser Stripe CLI `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price ID du tarif per-seat mensuel (2,90€ HT / employé / mois)
# Créé dans Stripe Dashboard > Products > Price
STRIPE_PRICE_ID="price_..."

# ----------------------------------------------
# 🔄 REDIS (optionnel pour cache / sessions)
# ----------------------------------------------
# Redis URL pour cache et sessions (si activé via Docker)
# REDIS_URL="redis://localhost:6379"

# ----------------------------------------------
# 🔒 SÉCURITÉ
# ----------------------------------------------
# CORS Origins autorisées (séparées par des virgules)
# CORS_ALLOWED_ORIGINS="http://localhost:3000,https://smartplanning.fr"

# Taux limite d'API (requests par minute)
# RATE_LIMIT_RPM=100

# ----------------------------------------------
# NOTES IMPORTANTES
# ----------------------------------------------
# 1. NE JAMAIS commit le fichier .env (déjà dans .gitignore)
# 2. Copier ce fichier vers .env et remplir les valeurs
# 3. Générer des clés secrètes sécurisées pour AUTH_SECRET
# 4. En production, utiliser des secrets managers (AWS Secrets Manager, Vercel Env Vars, etc.)
